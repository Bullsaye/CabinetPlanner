{
  "name": "cabinet-planner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine && tsc -p packages/i18n && tsc -p packages/cli",
    "check": "pnpm typecheck && pnpm test",
    "cp": "tsx packages/cli/src/main.ts",
    "preview": "tsx tools/preview/gen.ts",
    "app": "pnpm --filter @cabinet-planner/app dev",
    "app:build": "pnpm --filter @cabinet-planner/app build",
    "desktop": "pnpm --filter @cabinet-planner/desktop dev",
    "desktop:build": "pnpm --filter @cabinet-planner/desktop build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
